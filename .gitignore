# Maintainer notes -- never publish. Contains the de-anonymization checklist
# and the mapping from placeholder names to real ones.
MAINTAINER_NOTES.md

# Source media before scrubbing/compression. Only the scrubbed outputs in
# assets/videos/ should ever be committed.
raw_media/
*.mov
*.MOV
*.MP4

# OS / editor cruft. `.DS_Store` in particular leaks local folder names.
.DS_Store
Thumbs.db
*~
.idea/
.vscode/

# Paper source handed to the agent -- never publish unscrubbed.
raw_paper/

# Working files that must never be published: paper drafts dropped into
# assets/ (the page links assets/pdfs/paper.pdf only), editor backups, and
# writing-review notes.
assets/*.pdf
*.bak
*.writing-review.md
